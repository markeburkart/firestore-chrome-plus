{
  "manifest_version": 3,
  "name": "Firebase JSON Collapser",
  "version": "1.0.0",
  "description": "Collapse large JSON blocks in Firebase console for easier navigation",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://console.firebase.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://console.firebase.google.com/*"],
      "js": ["src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
